<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络请求 Open-Meteo 气象接口与第三方歌词源 API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 获取车载 GPS 定位以检索当地经纬度 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 小欧屏 / 多屏投屏与悬浮窗权限 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 长安欧尚原厂蓝牙电话权限 -->
    <uses-permission android:name="com.chinatsp.phone.permission" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <!-- 蓝牙音乐 AVRCP / A2DP 媒体与元数据接收权限 -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />

    <!-- 氛围灯音频频谱律动捕获 (Visualizer 及车机音频路由/混音会话监听) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_ROUTING" />
    <uses-permission android:name="android.permission.CAPTURE_AUDIO_OUTPUT" />

    <!-- 长安欧尚 Z6 车机 Automotive 底层信号读取权限 (纯 App 顶层接入) -->
    <uses-permission android:name="android.car.permission.CAR_CABIN" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="android.car.permission.CAR_VENDOR_EXTENSION" />
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_INFO" />
    <uses-permission android:name="android.car.permission.CAR_ENERGY" />
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_ENVIRONMENT" />

    <!-- 软件应用内自动更新与安装 APK 权限 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
    </queries>

    <application
        android:name=".XiaoOuApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.CarWeather">

        <!-- 主屏控制台与效果模拟调试 Activity (车规级单例任务栈) -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 车载歌词二级设置 Activity (内部重定向，关闭外部非必要导出) -->
        <activity
            android:name=".ui.LyricsSettingsActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.CarLyrics"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />

        <!-- 副屏全屏独立预览 Activity (车规级单例任务栈，可由控制台打开或 ADB 启动) -->
        <activity
            android:name=".ui.CarSubscreenActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />

        <!-- ADB 命令行与系统级外部指令广播接收器 (保留导予以支持 ADB 调试动画) -->
        <receiver
            android:name=".receiver.XiaoOuCommandReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.car.gear.SWITCH" />
                <action android:name="com.car.xiaoouscreen.SWITCH_GEAR" />
                <action android:name="com.car.xiaoouscreen.SHOW_TOP" />
                <action android:name="com.car.xiaoouscreen.SHOW_FITNESS" />
                <action android:name="com.car.xiaoouscreen.HIDE" />
                <action android:name="com.car.xiaoouscreen.TRIGGER_LIGHTNING" />
                <action android:name="com.car.xiaoouscreen.SIMULATE_PRESET" />
                <action android:name="com.car.xiaoouscreen.RESET_LIVE" />
                <action android:name="com.car.xiaoouscreen.CALL_EVENT" />
                <action android:name="com.car.xiaoouscreen.SIMULATE_MUSIC" />
                <action android:name="com.car.xiaoouscreen.SIMULATE_BATTERY" />
                <action android:name="com.car.xiaoouscreen.SIMULATE_TEMPS" />
                <action android:name="com.car.xiaoouscreen.SIMULATE_GFORCE" />
                <action android:name="com.car.xiaoouscreen.SIMULATE_MOTOR_POWER" />
                <action android:name="com.car.xiaoouscreen.SIMULATE_RPM" />
                <action android:name="com.car.xiaoouscreen.SIMULATE_LANE_CHANGE" />
                <action android:name="com.car.xiaoouscreen.SIMULATE_TURN_SIGNAL" />
                <action android:name="com.car.xiaoouscreen.SIMULATE_CLOUDEYE_EXIT" />
            </intent-filter>
        </receiver>

        <!-- 车机开机启动与 ACC 点火通电接收器 (参照 CarLyricsApp 稳定架构) -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="2147483647">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.REBOOT" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="android.intent.action.ACC_ON" />
                <action android:name="com.geely.intent.action.ACC_ON" />
            </intent-filter>
        </receiver>

        <!-- 小欧屏 Presentation / Overlay 前台投屏服务 (由内部及系统启动接收器调度，关闭外部无鉴权拉起) -->
        <service
            android:name=".service.WeatherOverlayService"
            android:stopWithTask="false"
            android:exported="false" />

        <!-- 通知监听服务 (用于兜底媒体识别与广播捕获) -->
        <service
            android:name="com.carlyrics.recognition.NotificationListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 媒体控制器服务 -->
        <service
            android:name="com.carlyrics.recognition.MediaControllerService"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- 应用内自动更新 APK 安装 FileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
