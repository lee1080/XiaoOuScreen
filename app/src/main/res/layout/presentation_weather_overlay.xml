<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootWeatherOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- 页面 1：写实多图层天气动态背景 + 居中时钟核心画布 -->
    <com.car.xiaoouscreen.ui.CarWeatherCanvasView
        android:id="@+id/weatherCanvasView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="visible" />

    <!-- 页面 2：车载歌词全屏展示视图 (Density 归一化自适应，初始隐藏) -->
    <com.carlyrics.display.LyricsNormalizedContainerView
        android:id="@+id/lyricsContainerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone"
        android:alpha="0" />

    <!-- 页面 3 (优先级 2)：1920×384 车辆模式切换由左至右纯原生光刃擦除视图 -->
    <com.car.xiaoouscreen.ui.DriveModeWipeView
        android:id="@+id/driveModeView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- 页面 4 (优先级 1)：1920×384 纯原生 3D 正方体档位翻转视图 -->
    <com.car.xiaoouscreen.ui.GearCubeFlipView
        android:id="@+id/gearCubeView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- 页面 5 (绝对置顶最高优先级)：左下角常驻微型档位指示器 (液态玻璃 HUD) -->
    <com.car.xiaoouscreen.ui.CarBottomLeftGearHudView
        android:id="@+id/bottomLeftGearHudView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="visible" />

    <!--
        自动消失的退出关闭按钮 (对齐车载成熟交互规范)
        平时完全隐藏，触摸屏幕任意位置即时唤出，5秒无操作自动淡出
    -->
    <FrameLayout
        android:id="@+id/closeButtonContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvCloseButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_close_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="\u2715"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

    </FrameLayout>

</FrameLayout>
