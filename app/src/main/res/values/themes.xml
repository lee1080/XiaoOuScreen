<resources>
    <style name="Theme.CarWeather" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">#F0F4F8</item>
    </style>

    <!-- 歌词设置基础主题 -->
    <style name="Theme.CarLyrics" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#007AFF</item>
        <item name="colorPrimaryDark">#000000</item>
        <item name="colorAccent">#007AFF</item>
        <item name="colorControlActivated">#007AFF</item>
        <item name="colorControlNormal">#8E8E93</item>
        <item name="alertDialogTheme">@style/IosAlertDialogTheme</item>
        <item name="android:alertDialogTheme">@style/IosAlertDialogTheme</item>
        <item name="android:windowBackground">@color/background_dark</item>
    </style>

    <!-- iOS 风格浅色弹窗主题 -->
    <style name="IosAlertDialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorPrimary">#007AFF</item>
        <item name="colorAccent">#007AFF</item>
        <item name="colorControlActivated">#007AFF</item>
        <item name="colorControlNormal">#8E8E93</item>
        <item name="android:textColor">#1C1C1E</item>
        <item name="android:textColorPrimary">#1C1C1E</item>
        <item name="android:textColorSecondary">#8E8E93</item>
        <item name="textColorAlertDialogListItem">#1C1C1E</item>
    </style>
</resources>
